{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["firebase.json", "**/.*"],
    "redirects": [
      {
        "source": "/qr/**",
        "destination": "https://greenwellsenergies.com/our-products-services/",
        "type": 302
      }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
