rules_version = '2';

// This deployment routes essentially all reads and every write through the
// NestJS API (using the Firebase Admin SDK, which bypasses these rules
// entirely) — the API is where RBAC, station-scoping, and financial-write
// authorization actually live. These rules exist as a defense-in-depth
// backstop in case a client SDK is ever pointed at Firestore directly
// (e.g. a future read-only dashboard widget), and deliberately default to
// deny-all for every collection except a couple of clearly safe,
// authenticated read-only cases.
//
// There is no direct client (web or Android) Firestore usage in this
// deliverable — both apps talk to Firestore exclusively via the API.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // No collection is client-writable. All writes go through the API
    // service account (Admin SDK), which is not subject to these rules.
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }

    // Example of the narrow, explicit exception pattern to follow if a
    // future feature needs a direct client read (left unused for now):
    // match /stations/{stationId} {
    //   allow read: if signedIn();
    // }
  }
}
