# Base URL of the NestJS API (include /api/v1). Relative by default — Vite's
# dev server proxies /api/* to http://localhost:8080 itself (see
# vite.config.ts), so the browser only ever talks to one origin. This is
# what makes testing over an ngrok tunnel or a LAN IP work without CORS or
# mixed-content issues. Use an absolute URL only for a production build.
VITE_API_BASE_URL=/api/v1

# Microsoft Entra ID — must match the API's MS_ENTRA_* values. See the root
# README's "Microsoft Entra setup".
VITE_MS_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_MS_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Leave VITE_MS_ENTRA_REDIRECT_URI unset (or delete the line) so it falls
# back to `${window.location.origin}/auth/microsoft/callback` (see
# apps/web/src/env.ts) — the same build then works from localhost:5173, a
# LAN IP, or an ngrok tunnel without editing this file, as long as every
# origin you actually use is also registered as a redirect URI in the
# Entra app registration (Authentication -> Single-page application). Only
# set this explicitly if you need to force one fixed value.
# VITE_MS_ENTRA_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback

# "demo" runs entirely on seeded in-memory mock data with no backend calls
# (useful for design review / offline demoing). "api" talks to the real API.
VITE_DATA_MODE=api
