# --- Server ---
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173

# --- Google Cloud / Firebase ---
# Local dev: point at a service account JSON with Firestore + Storage access.
# Cloud Run: leave unset and use the attached runtime service account instead.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
GCP_PROJECT_ID=green-wells-loyalty-dev
FIRESTORE_DATABASE_ID=(default)
GCS_BUCKET_NAME=green-wells-loyalty-dev-files

# --- Microsoft Entra ID (admin/chairman/finance approver/finance disburser/rtsm login) ---
# No client secret here — the SPA authenticates as a public client (PKCE);
# the API independently verifies the resulting id_token against Microsoft's
# JWKS. The Entra app registration's platform must be "Single-page
# application", not "Web" — a Web-platform registration rejects MSAL's
# browser PKCE flow.
MS_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_ENTRA_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback

# --- App session tokens ---
# Random 256-bit secrets. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ATTENDANT_JWT_TTL=12h

# --- SMS provider ---
# SMS_PROVIDER=mock logs instead of sending (safe default for dev).
# SMS_PROVIDER=africastalking sends via the Africa's Talking API using the
# credentials below (get these from the Africa's Talking dashboard).
SMS_PROVIDER=mock
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_BASE_URL=https://api.africastalking.com
AFRICASTALKING_SENDER_ID=

# --- Email provider ---
# EMAIL_PROVIDER=mock logs instead of sending (safe default for dev).
# EMAIL_PROVIDER=microsoft-graph sends via Microsoft Graph's application-only
# sendMail — requires a separate app registration (client credentials) with
# the Mail.Send *application* permission, admin-consented, distinct from the
# SPA's public-client login app above.
EMAIL_PROVIDER=mock
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_ADDRESS=

# --- Scheduled jobs ---
# Shared secret Cloud Scheduler sends as a header to protected job endpoints.
SCHEDULER_SHARED_SECRET=changeme-scheduler-secret
